#!/bin/sh

# Stop the FreePBX firewall daemon and remove only FreePBX-owned tables.
PID="$(pgrep -f '[v]oipfirewalld' 2>/dev/null)"
if [ -n "$PID" ]; then
	kill "$PID" 2>/dev/null || true
fi

NFT="$(command -v nft 2>/dev/null)"
if [ -n "$NFT" ]; then
	"$NFT" delete table inet fpbx 2>/dev/null || true
	"$NFT" delete table ip fpbxnat 2>/dev/null || true
fi
exit 0
