#!/usr/bin/env php
<?php
$trust = __DIR__.'/../Trust.class.php';
$stat = @lstat($trust);
if (is_link($trust) || !$stat || $stat['uid'] !== 0 || ($stat['mode'] & 0022)) {
	fwrite(STDERR, "Refusing to load the firewall trust helper\n");
	exit(1);
}
include $trust;
\FreePBX\modules\Firewall\Trust::assertRootFile('/etc/freepbx.conf');
$conf = file_get_contents('/etc/freepbx.conf');
if (!is_string($conf) || !preg_match('/AMPWEBROOT[\'"]\]\s*=\s*[\'"]([^\'"]+)/', $conf, $match)) {
	fwrite(STDERR, "Unable to resolve the FreePBX web root\n");
	exit(1);
}
\FreePBX\modules\Firewall\Trust::assertRootFile($match[1].'/admin/bootstrap.php');
$restrict_mods = array('firewall' => true);
include '/etc/freepbx.conf';

$fw = FreePBX::Firewall();
$resultFile = '/run/fpbx-firewall/migration-result.json';
try {
	$result = $fw->migrateFirewallBackend('nftables', false);
} catch (\Throwable $e) {
	$result = array('status' => false, 'message' => $e->getMessage());
}
\FreePBX\modules\Firewall\Trust::publish('migration-result.json', json_encode($result), 0644);
