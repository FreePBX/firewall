#!/usr/bin/env php
<?php
// vim: :set filetype=php tabstop=4 shiftwidth=4 autoindent smartindent:

require '/usr/lib/sysadmin/includes.php';
$restrict_mods  = array('firewall' => true);
$g 		= new \Sysadmin\GPG();
$sigfile	= __DIR__."/../module.sig";
$cfg		= \Sysadmin\FreePBX::Config();
$astspooldir	= $cfg->get('ASTSPOOLDIR');
$astlogdir	= '/var/log/asterisk';//$cfg->get('ASTLOGDIR');
$logfile 	= $astlogdir."/firewall.log";
$webuser 	= 'asterisk';//$cfg->get('AMPASTERISKWEBUSER');
$webgroup 	= 'asterisk'; //$cfg->get("AMPASTERISKWEBGROUP");
try {
	$sig = $g->checkSig($sigfile);
	if (!isset($sig['config']['hash']) || $sig['config']['hash'] !== "sha256") {
		throw new \Exception("Invalid sig file.. Hash is not sha256 - check $sigfile");
	}

	// Check the hash of the validator, before we include it
	if (empty($sig['hashes']['hooks/voipfirewalld'])) {
		throw new \Exception("Firewalld not part of module.sig");
	}

	$fd = __DIR__."/voipfirewalld";

	$fhash = hash_file('sha256', $fd);
	if ($fhash !== $sig['hashes']['hooks/voipfirewalld']) {
		throw new \Exception("Firewalld tampered");
	}
	$trust = __DIR__."/../Trust.class.php";
	$trustStat = @lstat($trust);
	if (is_link($trust) || !$trustStat || $trustStat['uid'] !== 0 || ($trustStat['mode'] & 0022)) {
		throw new \Exception("Firewall trust helper is not root-owned");
	}
	include $trust;
	$staged = \FreePBX\modules\Firewall\Trust::stageVerified($fd, "voipfirewalld", $sig['hashes']['hooks/voipfirewalld'], 0700);
	$log = "/var/log/asterisk/firewall.log";
	if (is_link("/var/log/asterisk") || is_link($log)) {
		throw new \Exception("Firewall log path is a symlink");
	}
	$pid = pcntl_fork();
	if ($pid < 0) {
		throw new \Exception("Unable to start the firewall daemon");
	}
	if ($pid === 0) {
		if (posix_setsid() < 0) {
			exit(1);
		}
		$output = fopen($log, "ab");
		if ($output) {
			posix_dup2(fileno($output), 1);
			posix_dup2(fileno($output), 2);
		}
		pcntl_exec($staged, array());
		exit(1);
	}
	exit(0);
} catch (\Exception $e) {
	print "Error: ".$e->getMessage().". Sleeping for 10 seconds and retrying start.\n";
	sleep(10);
	$retry = "/var/spool/asterisk/incron/firewall.firewall";
	if (!is_link($retry) && !is_link(dirname($retry))) {
		touch($retry);
	}
	exit;
}

// Start the daemon
exit(0);
