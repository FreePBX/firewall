#!/usr/bin/php -q
<?php
$fwconsole = '/usr/sbin/fwconsole';
$target = realpath($fwconsole);
$stat = $target ? @stat($target) : false;
if ($target === false || is_link($target) || !$stat || $stat['uid'] !== 0 || ($stat['mode'] & 0022)
	|| !preg_match('#^/(?:usr/)?s?bin/#', $target)) {
	fwrite(STDERR, "Refusing to run fwconsole\n");
	exit(1);
}
$process = proc_open(array($target, 'firewall', 'fix_custom_rules'), array(1 => array('pipe', 'w'), 2 => array('pipe', 'w')), $pipes);
if (!is_resource($process)) {
	exit(1);
}
stream_get_contents($pipes[1]);
stream_get_contents($pipes[2]);
fclose($pipes[1]);
fclose($pipes[2]);
exit(proc_close($process));
